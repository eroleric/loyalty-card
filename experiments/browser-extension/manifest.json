{
  "manifest_version": 3,
  "name": "Loyalty Card Circle K minimal test",
  "version": "0.0.1",
  "description": "Non-submitting test using a reserved fictional phone. Not a production enrollment tool.",
  "content_scripts": [{
    "matches": ["https://auth.circlek.com/*"],
    "js": ["probe.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }, {
    "matches": ["https://inner-circle.circlek.com/*"],
    "js": ["web-access-probe.js"],
    "world": "MAIN",
    "run_at": "document_idle"
  }]
}
